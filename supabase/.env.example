# Loaded by `supabase functions serve --env-file ./supabase/.env` for local dev.
# In deployed environments these are set with `supabase secrets set ...` instead.

# --- Supabase (auto-injected in hosted edge functions; only needed for local `serve`) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=PASTE_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=PASTE_SUPABASE_SERVICE_ROLE_KEY

# --- Environment tag (drives error-detail leakage + Sentry `environment`) ---
# "development" | "staging" | "production" — defaults to "production" if unset.
APP_ENV=development

# --- CORS (comma-separated). Leave unset locally to allow all origins. ---
# ALLOWED_ORIGINS=https://your-staging-domain.com,https://your-prod-domain.com

# --- Payments (Xendit) ---
XENDIT_SECRET_KEY=PASTE_XENDIT_SECRET_KEY
XENDIT_WEBHOOK_TOKEN=PASTE_XENDIT_WEBHOOK_TOKEN
APP_URL=http://localhost:3000

# --- pg_cron gate (requireCronSecret) ---
# Must match the x-cron-secret header sent by the pg_cron -> net.http_post
# call scheduled in supabase/migrations/0089_secure_cron_endpoints.sql.
CRON_SECRET=PASTE_CRON_SECRET

# --- Transactional email (Resend) ---
RESEND_API_KEY=PASTE_RESEND_API_KEY
RESEND_FROM_EMAIL=no-reply@your-domain.com

# --- Error reporting (optional — no-ops if unset) ---
SENTRY_DSN=
RELEASE=
