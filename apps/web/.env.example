NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_ANON_KEY

# Workspace served by this deployment (defaults to "demo-cafe" if unset).
NEXT_PUBLIC_WORKSPACE_SLUG=demo-cafe

# "development" | "staging" | "production" — set explicitly per Render service.
NEXT_PUBLIC_APP_ENV=development

# Customer ordering / booking flows. OFF unless set to exactly "on" — there is
# no customer payment gateway yet, so the site takes no money online. With a
# flag off, its routes redirect to /unavailable and its CTAs point at the menu
# or the call/message notice. Flip to "on" per environment once a gateway lands.
NEXT_PUBLIC_ONLINE_ORDERING=off
NEXT_PUBLIC_ONLINE_BOOKING=off

# Error reporting (optional — no-ops if unset). SENTRY_DSN is server-side only.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_RELEASE=
