.claude/tasks/

# Android build output — same rationale as apps/pos-app/ios/ below.
# apps/pos-app/android/ is a fully regenerable `expo prebuild` scaffold
# with no custom native source, so there's no carve-out needed. Scoped to
# these exact paths (not a bare `android/`) — that used to also match
# apps/pos-app/modules/*/android/, which DOES hold real custom native
# source (esc-printer, customer-display) that must stay tracked.
/android/
apps/pos-app/android/

# iOS build output — same rationale as android/ above. apps/pos-app/ios/ is a
# fully regenerable `expo prebuild` scaffold (Pods/, build/, .xcode.env.local)
# with no custom native source, so unlike android/ there's no carve-out needed.
apps/pos-app/ios/

# TypeScript incremental build cache
*.tsbuildinfo

# backup files
*.bak

# JetBrains IDE
.idea/

# Supabase CLI cache
supabase/supabase/.temp/

# Supabase Studio scratch queries
supabase/snippets/

# SonarQube scanner cache
.scannerwork/
